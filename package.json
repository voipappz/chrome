{
  "name": "va-voipbox-chrome",
  "version": "1.0.0",
  "description": "Generated with @larscom/ng-chrome-extension",
  "scripts": {
    "ng": "ng",
    "start": "npm run watch",
    "build:angular": "ng build",
    "build:angular-production": "ng build --prod",
    "watch:angular": "ng build --watch --delete-output-path false",
    "build:chrome": "NODE_OPTIONS=--openssl-legacy-provider webpack --config chrome/webpack.config.js",
    "build:chrome-production": "NODE_OPTIONS=--openssl-legacy-provider webpack -p --config chrome/webpack.config.prod.js",
    "watch:chrome": "NODE_OPTIONS=--openssl-legacy-provider webpack --config chrome/webpack.config.js -w",
    "build": "npm run clean && npm run build:angular && npm run build:chrome",
    "build:production": "npm run build:angular-production && npm run build:chrome-production && npm run pack",
    "watch": "npm run clean && npm-run-all --parallel watch:*",
    "clean": "rimraf angular/dist",
    "pack": "cd angular/dist && bestzip ../../extension-build.zip *",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^11.0.2",
    "@angular/cdk": "^11.2.9",
    "@angular/common": "^11.0.2",
    "@angular/compiler": "^11.0.2",
    "@angular/core": "^11.0.2",
    "@angular/forms": "^11.0.2",
    "@angular/material": "^11.2.9",
    "@angular/platform-browser": "^11.0.2",
    "@angular/platform-browser-dynamic": "^11.0.2",
    "@angular/router": "^11.0.2",
    "@rails/actioncable": "^6.1.3-1",
    "angular2-websocket": "^0.9.8",
    "core-js": "^2.6.11",
    "nats.ws": "^1.30.3",
    "ng2-ui-auth": "^10.0.1",
    "rxjs": "~6.5.4",
    "tslib": "^2.0.0",
    "zone.js": "^0.10.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^0.1100.2",
    "@angular/cli": "^11.0.2",
    "@angular/compiler-cli": "^11.0.2",
    "@angular/language-service": "^11.0.2",
    "@playwright/test": "^1.44.0",
    "@types/chrome": "0.0.81",
    "@types/node": "^12.12.32",
    "awesome-typescript-loader": "^5.2.1",
    "bestzip": "^2.1.7",
    "codelyzer": "^6.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^2.7.1",
    "ts-loader": "^8.4.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.3",
    "typescript": "~4.0.5",
    "webpack": "^4.42.1",
    "webpack-cli": "^3.3.11"
  }
}
